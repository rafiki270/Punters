# Local SQLite database (relative to prisma/). No secrets live here.
DATABASE_URL="file:../data/punters.db"

# The Punters relay this venue signs in and syncs through — see ../AUTH_ARCHITECTURE.md.
# RELAY_URL is used for server-to-server calls (session verify, sync polling).
# RELAY_PUBLIC_URL is what the browser is redirected to for login — set it if that's a
# different address (e.g. RELAY_URL is an internal address, RELAY_PUBLIC_URL is the real
# public HTTPS hostname). Defaults to RELAY_URL when unset.
RELAY_URL="http://localhost:4100"
RELAY_PUBLIC_URL="http://localhost:4100"

# Dev convenience only: skips the sign-in/venue-binding gate entirely. Never set this
# for a real venue — it disables authentication for the whole admin API.
AUTH_DISABLED="false"
