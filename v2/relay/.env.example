# Local SQLite database.
DATABASE_URL="file:../data/relay.db"

# Public hostname this relay is deployed at — must be real HTTPS for UOA to reach it.
RELAY_PUBLIC_URL="https://cloud.punters.example"

# UOA integration.
UOA_BASE_URL="https://authentication.unlikeotherai.com"
UOA_DOMAIN="cloud.punters.example"
UOA_CONTACT_EMAIL="ops@punters.example"
# From Phase 1.5 of the onboarding checklist (relay/README.md) — claimed once, then stored.
UOA_CLIENT_SECRET=""
UOA_CLIENT_HASH=""

# RS256 keypairs (PKCS8 private key PEM, one line with \n escapes, or a path — see
# scripts/generate-keys.ts). Two independent keys: one signs the config JWT UOA verifies,
# the other signs the relay's own venue-session tokens (kept separate on purpose).
CONFIG_SIGNING_PRIVATE_KEY_PEM=""
CONFIG_SIGNING_KID="punters-config-2026"
SESSION_SIGNING_PRIVATE_KEY_PEM=""
SESSION_SIGNING_KID="punters-session-2026"

PORT=4100
